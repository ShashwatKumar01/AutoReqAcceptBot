# Telegram Bot Token from BotFather
BOT_TOKEN=

# MongoDB (Atlas or local). App env var is MONGODB_URI (not MONGO_URI).
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=Cluster0
MONGODB_DATABASE=RequestAcceptBot

# Redis (use Railway Redis plugin URL in production)
REDIS_URL=redis://localhost:6379/0

# Webhook (required when ENVIRONMENT=production)
WEBHOOK_URL=https://your-service.up.railway.app
WEBHOOK_SECRET=change_me_to_random_string
WEBHOOK_PATH=/webhook

# Super admins (comma-separated Telegram user IDs)
SUPER_ADMIN_IDS=123456789

# Admin web dashboard (/admin/) — Bearer token for API login
ADMIN_API_SECRET=change_me_to_random_string
ADMIN_WEB_ENABLED=true

LOG_LEVEL=INFO
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000

APPROVAL_POLL_INTERVAL=10
BROADCAST_BATCH_SIZE=30
BROADCAST_RATE_LIMIT=30
MAX_CONNECTED_CHATS_FREE=3
MAX_BROADCAST_RECIPIENTS_FREE=1000

# Mongo backup (scripts/mongo_backup.py, GitHub Actions workflow)
# BACKUP_DIR=./backups
